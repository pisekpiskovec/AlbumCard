<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>io.github.pisekpiskovec.AlbumCard</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>AlbumCard</name>
  <summary>Next generation of audio taggers</summary>
  <description>
    <p>Edit your albums like you would see them on streaming services. Edit values in global album tags, or overwrite them in a track directly.</p>
  </description>

  <categories>
    <category>AudioVideo</category>
    <category>AudioVideoEditing</category>
  </categories>

  <keywords>
    <keyword>id3v2</keyword>
    <keyword>mp3</keyword>
    <keyword>tag</keyword>
    <keyword>tagger</keyword>
    <keyword>title</keyword>
    <keyword>artist</keyword>
    <keyword>metadata</keyword>
    <keyword>metainfo</keyword>
    <keyword>album</keyword>
  </keywords>

  <developer id="pisekpiskovec">
    <name>Písek Pískovec</name>
  </developer>

